        ],
      },
      {
        label: '2nd Runner-up',
        items: [
          'BSIS National Science & Innovation Carnival 2024 · Project Display (Higher Secondary)',
          '1st AKSC National Science Carnival 2024 · Project Display (Higher Secondary)',
          'BSIS National Science & Innovation Carnival 2024 · Sci-fi Story Writing (Higher Secondary)',
