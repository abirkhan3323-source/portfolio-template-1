---

<section id="achievements" class="s-achievements">
  <div class="s__inner">
    <h2 class="s__title">Achievements</h2>

    <div class="s__content">
      {
        groups.map((group) => (
          <div class="a-group">
            <h3 class="a-group__title">{group.title}</h3>

            {group.items ? (
              <ul class="a-list">
                {group.items.map((item) => (
                  <li class="a-list__item">{item}</li>
                ))}
              </ul>
            ) : (
              group.tiers.map((tier) => (
                <div class="a-tier">
                  <h4 class="a-tier__label">{tier.label}</h4>

                  <ul class="a-list">
                    {tier.items.map((item) => (
                      <li class="a-list__item">{item}</li>
                    ))}
                  </ul>
                </div>
              ))
            )}
          </div>
        ))
      }
    </div><!-- .s__content -->
  </div><!-- .s__inner -->
</section>

<style lang="scss">
  .s-achievements {
    --width: 46rem;

    position: relative;
    z-index: 3;

    padding: 10rem 0;

    @include mq(tablet-sm) {
      --width: 70vw;

      padding: 5rem 0;
    }

    @include mq(phone) {
      --width: 84vw;
    }

    .s__inner {
      margin: 0 auto;
      width: var(--width);

      border: 1px solid color(secondary);
    }

    .s__title {
      margin: 0;
      padding: 0 0 2px;

      background: color(secondary);

      color: color(primary);
      font: 700 12px / 24px font-family(fraktion);
      letter-spacing: 0.1em;
      text-align: center;
      text-transform: uppercase;
    }

    .s__content {
      padding: 4rem 4.5rem;

      font: 200 1.5rem / 1.5 font-family(editorial);

      @include mq(phone) {
        padding: 2.5rem 1.75rem;

        font-size: 1.25rem;
      }
    }

    .a-group {
      & + .a-group {
        margin-top: 3.5rem;
        padding-top: 3.5rem;

        border-top: 1px solid color(secondary);
      }
    }

    .a-group__title {
      margin: 0 0 1.5rem;

      color: color(secondary);
      font: 700 13px / 1 font-family(fraktion);
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .a-tier {
      & + .a-tier {
        margin-top: 2rem;
      }
    }

    .a-tier__label {
      margin: 0 0 0.75rem;

      font: 400 12px / 1 font-family(fraktion);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .a-list {
      margin: 0;
      padding: 0;

      list-style: none;
    }

    .a-list__item {
      position: relative;

      padding-left: 1.5em;

      & + .a-list__item {
        margin-top: 0.5em;
      }

      &:before {
        position: absolute;
        top: 0.65em;
        left: 0;

        width: 0.6em;
        height: 1px;

        background: color(secondary);

        content: '';
      }
    }
  }
</style>
